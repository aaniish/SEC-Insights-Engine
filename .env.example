# Pull real values with `vercel env pull .env.local` after `vercel link`.

# Neon Postgres (added automatically by the Vercel Neon integration)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# AI Gateway: on Vercel, auth is automatic via OIDC (VERCEL_OIDC_TOKEN from `vercel env pull`).
# Outside Vercel, create a key in the AI Gateway dashboard instead:
# AI_GATEWAY_API_KEY=

# SEC requires a contact email in the User-Agent of every request.
SEC_EMAIL_ADDRESS=you@example.com

# Models (any AI Gateway model id)
CHAT_MODEL_FAST=openai/gpt-6-luna
CHAT_MODEL_DEEP=openai/gpt-6-sol
EMBEDDING_MODEL=openai/text-embedding-3-small

# Daily limits (per visitor / global circuit breakers)
RATE_LIMIT_FAST_PER_DAY=30
RATE_LIMIT_DEEP_PER_DAY=5
RATE_LIMIT_INDEX_PER_DAY=3
GLOBAL_QUESTIONS_PER_DAY=1000
GLOBAL_INDEXING_PER_DAY=25

# Random strings: `openssl rand -hex 24`
IP_HASH_SALT=
CRON_SECRET=
